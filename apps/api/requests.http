# Requisições da API do JobPilot para a extensão REST Client do VS Code
# (humao.rest-client). Clique em "Send Request" acima de cada bloco.
#
# Ordem sugerida na primeira vez:
#   1. cadastro (só se a conta ainda não existir)
#   2. login (guarda o token usado por todas as outras requisições)
#   3. criarEmpresa
#   4. criarVaga
# O token e os IDs são capturados das respostas e reaproveitados nas demais requisições.

@baseUrl = http://localhost:3333
@token = {{login.response.body.accessToken}}
@refreshToken = {{login.response.body.refreshToken}}
@empresaId = {{criarEmpresa.response.body.id}}
@vagaId = {{criarVaga.response.body.id}}
@candidaturaId = {{criarCandidatura.response.body.id}}
@curriculoId = {{criarCurriculo.response.body.id}}
@etapaId = {{criarEtapa.response.body.id}}

### Health check
GET {{baseUrl}}/health


###############################################################
# Autenticação
###############################################################

### Cadastro (devolve usuário + tokens)
# @name cadastro
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nome": "Ana Souza",
  "email": "ana@exemplo.com",
  "senha": "senha-forte-123"
}

### Login (rode este para preencher o token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ana@exemplo.com",
  "senha": "senha-forte-123"
}

### Usuário logado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Renovar tokens
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Erro esperado: senha errada (401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ana@exemplo.com",
  "senha": "errada"
}


###############################################################
# Empresas
###############################################################

### Criar empresa
# @name criarEmpresa
POST {{baseUrl}}/empresas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Nubank",
  "site": "https://nubank.com.br"
}

### Listar empresas
GET {{baseUrl}}/empresas
Authorization: Bearer {{token}}

### Buscar empresas pelo nome
GET {{baseUrl}}/empresas?busca=nu
Authorization: Bearer {{token}}

### Ver empresa
GET {{baseUrl}}/empresas/{{empresaId}}
Authorization: Bearer {{token}}

### Editar empresa
PUT {{baseUrl}}/empresas/{{empresaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Nu Pagamentos",
  "site": "https://nubank.com.br"
}

### Remover empresa (409 enquanto ela tiver vagas)
DELETE {{baseUrl}}/empresas/{{empresaId}}
Authorization: Bearer {{token}}


###############################################################
# Vagas
###############################################################

### Criar vaga
# @name criarVaga
POST {{baseUrl}}/vagas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "empresaId": "{{empresaId}}",
  "titulo": "Desenvolvedora Vue",
  "descricao": "Front-end com Vue 3, TypeScript e Pinia",
  "url": "https://nubank.com.br/vagas/123",
  "modalidade": "REMOTO",
  "senioridade": "JUNIOR"
}

### Listar vagas
GET {{baseUrl}}/vagas
Authorization: Bearer {{token}}

### Filtrar vagas (modalidade: REMOTO | HIBRIDO | PRESENCIAL)
GET {{baseUrl}}/vagas?modalidade=REMOTO&senioridade=JUNIOR&busca=vue
Authorization: Bearer {{token}}

### Vagas de uma empresa
GET {{baseUrl}}/vagas?empresaId={{empresaId}}
Authorization: Bearer {{token}}

### Ver vaga
GET {{baseUrl}}/vagas/{{vagaId}}
Authorization: Bearer {{token}}

### Editar vaga
PUT {{baseUrl}}/vagas/{{vagaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "empresaId": "{{empresaId}}",
  "titulo": "Desenvolvedora Vue Pleno",
  "descricao": "Front-end com Vue 3, TypeScript e Pinia",
  "modalidade": "HIBRIDO",
  "senioridade": "PLENO"
}

### Remover vaga
DELETE {{baseUrl}}/vagas/{{vagaId}}
Authorization: Bearer {{token}}

### Erro esperado: validação (400 com detalhes por campo)
POST {{baseUrl}}/vagas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "empresaId": "{{empresaId}}",
  "titulo": "",
  "descricao": "",
  "modalidade": "LUA"
}


###############################################################
# Candidaturas (rode "Criar vaga" antes)
###############################################################

### Candidatar-se à vaga (nasce como INTERESSE)
# @name criarCandidatura
POST {{baseUrl}}/candidaturas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vagaId": "{{vagaId}}",
  "proximoFollowup": "2026-11-05"
}

### Listar minhas candidaturas
GET {{baseUrl}}/candidaturas
Authorization: Bearer {{token}}

### Filtrar por status (INTERESSE | APLICADO | ENTREVISTA | OFERTA | ENCERRADO)
GET {{baseUrl}}/candidaturas?status=APLICADO
Authorization: Bearer {{token}}

### Ver candidatura
GET {{baseUrl}}/candidaturas/{{candidaturaId}}
Authorization: Bearer {{token}}

### Alterar as datas (null limpa o campo)
PATCH {{baseUrl}}/candidaturas/{{candidaturaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dataAplicacao": "2026-10-22",
  "proximoFollowup": null
}

### Mover para APLICADO
PATCH {{baseUrl}}/candidaturas/{{candidaturaId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "APLICADO"
}

### Erro esperado: pular etapas (409). Rode com a candidatura em INTERESSE
PATCH {{baseUrl}}/candidaturas/{{candidaturaId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "OFERTA"
}

### Remover candidatura
DELETE {{baseUrl}}/candidaturas/{{candidaturaId}}
Authorization: Bearer {{token}}


###############################################################
# Currículos (só um fica ativo por vez)
###############################################################

### Salvar currículo (o primeiro já nasce ativo)
# @name criarCurriculo
POST {{baseUrl}}/curriculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conteudo": "Ana Souza, desenvolvedora front-end com Vue 3, TypeScript e Pinia. Experiência com testes e CI.",
  "ativo": true
}

### Listar meus currículos
GET {{baseUrl}}/curriculos
Authorization: Bearer {{token}}

### Ver o currículo ativo
GET {{baseUrl}}/curriculos/ativo
Authorization: Bearer {{token}}

### Ver um currículo
GET {{baseUrl}}/curriculos/{{curriculoId}}
Authorization: Bearer {{token}}

### Editar o texto
PUT {{baseUrl}}/curriculos/{{curriculoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conteudo": "Ana Souza, desenvolvedora full stack com Vue 3, Node, PostgreSQL e testes automatizados."
}

### Ativar este currículo (o ativo atual é desativado)
POST {{baseUrl}}/curriculos/{{curriculoId}}/ativar
Authorization: Bearer {{token}}

### Remover (409 se for o ativo e houver outros; apaga as análises feitas com ele)
DELETE {{baseUrl}}/curriculos/{{curriculoId}}
Authorization: Bearer {{token}}

### Erro esperado: texto curto demais (400)
POST {{baseUrl}}/curriculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "conteudo": "oi"
}


###############################################################
# Etapas da candidatura (rode "Candidatar-se à vaga" antes)
###############################################################

### Registrar uma etapa (data em ISO 8601 com fuso)
# @name criarEtapa
POST {{baseUrl}}/candidaturas/{{candidaturaId}}/etapas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tipo": "ENTREVISTA_RH",
  "data": "2026-11-05T14:00:00-03:00",
  "anotacoes": "Conversa de 30 minutos com a Carla"
}

### Linha do tempo (em ordem cronológica)
GET {{baseUrl}}/candidaturas/{{candidaturaId}}/etapas
Authorization: Bearer {{token}}

### Editar a etapa
PUT {{baseUrl}}/candidaturas/{{candidaturaId}}/etapas/{{etapaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tipo": "ENTREVISTA_TECNICA",
  "data": "2026-11-12T10:00:00-03:00",
  "anotacoes": "Remarcada: entrevista técnica com o time de front-end"
}

### Remover a etapa
DELETE {{baseUrl}}/candidaturas/{{candidaturaId}}/etapas/{{etapaId}}
Authorization: Bearer {{token}}

### Erro esperado: data sem fuso (400)
POST {{baseUrl}}/candidaturas/{{candidaturaId}}/etapas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tipo": "TRIAGEM",
  "data": "2026-11-05T14:00:00"
}
