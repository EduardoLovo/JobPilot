# Copie para .env e ajuste os valores

# PostgreSQL (docker-compose)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot

# Banco dos testes de integração (o nome precisa terminar com _test; é criado automaticamente)
TEST_DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot_test

# API
API_PORT=3333
JWT_SECRET=troque-este-segredo

# n8n
N8N_PORT=5678
N8N_API_KEY=troque-esta-chave

# MCP
JOBPILOT_API_URL=http://localhost:3333
